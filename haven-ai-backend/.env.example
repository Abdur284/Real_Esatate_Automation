# Copy to .env and fill in. Never commit .env.

PROJECT_NAME="Haven AI"

# Google AI Studio key for the chatbot and the 2D planner
GEMINI_API_KEY=
# Optional model overrides (comma separated fallbacks for the 2D planner)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODELS_2D=gemini-2.5-flash,gemini-flash-latest

# Firebase Admin service-account key (Firebase console -> Project settings ->
# Service accounts -> Generate new private key). Keep the file out of git.
FIREBASE_CREDS_PATH=firebase-credentials.json

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173

# Requests per minute per user/IP on AI and heavy endpoints (0 = no limit)
RATE_LIMIT_PER_MINUTE=20

# External module services for the chatbot; MOCK = built-in sample data
COST_ESTIMATION_API_URL=MOCK
PROPERTY_REC_API_URL=MOCK
INTERIOR_DESIGN_API_URL=MOCK
