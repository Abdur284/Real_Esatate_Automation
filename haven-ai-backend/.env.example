# Copy to .env and fill in. Never commit .env.

PROJECT_NAME="Haven AI"

# Google AI Studio key for the chatbot, 2D planner and 3D Design vision
GEMINI_API_KEY=
# Optional model overrides (comma separated fallbacks where a list is used).
# Flash is the default; Pro models have little/no free-tier quota (429).
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODELS_2D=gemini-flash-latest,gemini-3.8-flash

# 3D Design from a text prompt (POST /api/design/3d/generate):
#   builtin = local rule-based room planner
#   gemini  = Gemini generates the 2D layout, then it is built in 3D
# DESIGN3D_TEXT_GENERATOR=gemini

# 3D Design floor-plan reading (POST /api/design/3d/analyze):
#   builtin = local OpenCV pipeline (needs OpenCV installed)
#   gemini  = read the drawing with Gemini vision (no OpenCV needed)
# PLAN_ANALYZER=gemini
# GEMINI_PLAN_MODELS=gemini-flash-latest,gemini-3.8-flash

# 3D Design property-photo analysis: builtin (local) or gemini (vision)
# DESIGN3D_PHOTO_ANALYZER=gemini
# GEMINI_VISION_MODELS=gemini-flash-latest,gemini-3.8-flash
# Photorealistic render needs an image-generation model + billing enabled.
# GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image

# Firebase Admin service-account key (Firebase console -> Project settings ->
# Service accounts -> Generate new private key). Keep the file out of git.
FIREBASE_CREDS_PATH=firebase-credentials.json

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173

# Requests per minute per user/IP on AI and heavy endpoints (0 = no limit)
RATE_LIMIT_PER_MINUTE=20

# External module services for the chatbot; MOCK = built-in sample data
COST_ESTIMATION_API_URL=MOCK
PROPERTY_REC_API_URL=MOCK
INTERIOR_DESIGN_API_URL=MOCK

# Forgotten password: the 6-digit code is emailed over SMTP. With Gmail, turn
# on 2-Step Verification and create an App Password (Google Account ->
# Security -> App passwords); use it as SMTP_PASSWORD, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Local testing without email: print the code in the server log instead
RESET_CODE_LOG_ONLY=false

# Zameen.com listings on the Properties page. Leave ZAMEEN_API_URL empty to
# turn them off, MOCK shows a few "[Sample]" listings, otherwise the API base
# URL from Zameen's documentation. The key stays on the server.
ZAMEEN_API_URL=
ZAMEEN_API_KEY=
