# Copy to .env.local for local overrides. Only VITE_* values reach the browser,
# so never put secrets here.

# Backend URL in production (empty in development: Vite proxies /api to :8000)
VITE_API_BASE_URL=

# Firebase web config (public identifiers; defaults are in src/firebase.js)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
